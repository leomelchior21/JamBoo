# Copy this file to .env.local for local Vercel development, or configure the
# same server-only variables in Vercel Project Settings. Do not use a public
# client-side prefix and do not commit the real values.

# DeepSeek is the default quiz generator. DEEPSEEK_API_KEY is server-side only:
# it is never sent to the browser or to any client device.
DEEPSEEK_API_KEY=
# JamBoo is pinned to DeepSeek-V4.1-Flash. Legacy Flash names
# (deepseek-v4-flash, deepseek-chat) are accepted; any other value is ignored
# and logged, so generation never silently moves to another model.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TEMPERATURE=0.2
# How thinking is disabled on every quiz request: "thinking" sends
# {"thinking":{"type":"disabled"}} (default); "reasoning_effort" sends
# {"reasoning_effort":"none"} for endpoints that require it; "none" omits the
# parameter entirely (escape hatch only if the endpoint rejects both).
DEEPSEEK_DISABLE_THINKING_PARAM=thinking
# Structured output: json_object (default) sends response_format. Set to "none"
# only if the endpoint rejects response_format; the server still validates JSON.
DEEPSEEK_RESPONSE_FORMAT=json_object

# Provider selection. Default is deepseek. Set to "local" to experiment with
# the Ollama model again. ALLOW_LOCAL_AI_FALLBACK defaults to false: when the
# default generator fails, the quiz fails clearly instead of silently serving
# local-model content. Set it to true only if you explicitly want that fallback.
# QUIZ_AI_PROVIDER=deepseek
# ALLOW_LOCAL_AI_FALLBACK=false

# Local Ollama server, server-side only. Required only for the local provider
# and for the /api/ai/health Ollama check.
OLLAMA_URL=

# Optional server-side tuning. Defaults are shown.
OLLAMA_MODEL=qwen3.5:4b
# Whole-request budget. Quiz batches stop starting provider calls near the
# deadline and return the unfinished slots as failedSlots (HTTP 200) so the
# browser can retry them instead of losing the request to a 504.
QUIZ_AI_TIMEOUT_MS=140000
OLLAMA_HEALTH_TIMEOUT_MS=5000
QUESTION_BATCH_SIZE=6
# Targeted repair rounds per category. Transient provider failures (429/5xx,
# timeouts) are retried inside these rounds; fatal errors (401/402/400) fail fast.
MAX_REPAIR_ATTEMPTS=1
