# Copy this file to .env.local for local Vercel development, or configure the
# same server-only variable in Vercel Project Settings. Do not use a public
# client-side prefix and do not commit the real tunnel address.
OLLAMA_URL=

# Optional server-side tuning. Defaults are shown.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=140000
OLLAMA_HEALTH_TIMEOUT_MS=5000
QUESTION_BATCH_SIZE=6
MAX_REPAIR_ATTEMPTS=2

# Optional live web-search provider, used for CURRENT categories and as a
# fallback for HISTORICAL categories. Without it JamBoo still uses Wikipedia
# for historical facts and simply avoids current-events questions.
# SEARCH_API_URL is the only required variable; the endpoint receives
# {"query":"...","max_results":N} as JSON on POST and should answer with a
# JSON results array. All calls stay server-side; the key never reaches the
# browser.
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_API_RESULTS_PATH=results
# SEARCH_API_NAME=WebSearch
